---
interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  script?: boolean;
  showNav?: boolean;
}

const {
  title,
  description = 'Backend Developer specializing in NestJS, Laravel, and scalable systems.',
  ogTitle,
  script = true,
  showNav = false,
} = Astro.props;

const { pathname } = Astro.url;

---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {ogTitle && <meta property="og:title" content={ogTitle}>}
  <meta property="og:description" content={description}>
  <meta property="og:image" content="https://hihebark.github.io/assets/images/logo2.png">
  <meta property="og:type" content="website">
  <meta name="author" content="Amara Nezli">
  <link rel="canonical" href={new URL(Astro.url.pathname, 'https://hihebark.github.io')}>
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
  <link rel="preload" href="/assets/fonts/SourceCodePro-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
  <slot name="head" />
</head>
<body>
  {showNav && (
    <nav class="site-nav">
      <a href="/" class="page-logo">virtualstruct<span class="logo-dot">.</span></a>
      <div class="site-nav-links">
        <a href="/portfolio" class:list={{ active: pathname.startsWith('/portfolio') }}>Portfolio</a>
        <a href="/projects" class:list={{ active: pathname.startsWith('/projects') }}>Projects</a>
        <a href="/notes" class:list={{ active: pathname.startsWith('/notes') || pathname.startsWith('/case-studies') }}>Notes</a>
        <a href="mailto:n.amara@protonmail.ch">Contact</a>
      </div>
    </nav>
  )}
  <main>
    <slot />
  </main>

{script && <script is:inline src="/js/main.js"></script>}
</body>
</html>
